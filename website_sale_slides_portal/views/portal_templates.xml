<odoo>
    <template
        id="portal_my_home_menu_courses"
        name="Portal layout: courses menu entry"
        inherit_id="portal.portal_breadcrumbs"
    >
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'courses'" class="breadcrumb-item active">
                Courses
            </li>
        </xpath>
    </template>

    <template
        id="portal_my_home_courses"
        name="Show Courses"
        inherit_id="portal.portal_my_home"
        customize_show="True"
        priority="30"
    >
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_client_category_enable" t-value="True" />
        </xpath>
        <div id="portal_client_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t
                    t-set="icon"
                    t-value="'/website_sale_slides_portal/static/src/img/courses.png'"
                />
                <t t-set="title">Courses</t>
                <t t-set="text">Information about courses and participations.</t>
                <t t-set="url" t-value="'/my/courses'" />
                <t t-set="placeholder_count" t-value="'courses_count'" />
            </t>
        </div>
    </template>

    <template id="portal_my_courses" name="My courses">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />
            <t t-if="searchbar_sortings" t-call="portal.portal_searchbar">
                <t t-set="title">Courses</t>
            </t>
            <t t-if="not courses">
                <div class="alert alert-warning" role="alert">
                    There are no courses.
                </div>
            </t>
            <t t-if="courses" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th class="w-75">Course</th>
                        <th>Used</th>
                        <th>Remaining</th>
                        <th>Total</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="courses" t-as="course">
                        <td>
                            <a
                                t-att-href="'/slides/%s' % slug(course.channel_id) if course.available_registrations == 1 else course.invitation_link"
                                target="_blank"
                            >
                                <span t-field="course.channel_id.name" />
                            </a>
                        </td>
                        <td class="text-center">
                            <span t-field="course.used_registrations" />
                        </td>
                        <td class="text-center">
                            <span t-field="course.remaining_registrations" />
                        </td>
                        <td class="text-center">
                            <span t-field="course.available_registrations" />
                        </td>
                        <td class="text-center">
                            <button
                                type="button"
                                class="btn btn-primary js_copy_invitation_link"
                                t-att-data-clipboard-text="course.invitation_link"
                            >
                                Copy link
                            </button>
                        </td>
                    </tr>
                </tbody>
            </t>
        </t>
    </template>
</odoo>
