#. module: website_sale_slides_multi_qty
#: model:mail.template,body_html:website_sale_slides_multi_qty.mail_template_slide_channel_confirm
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    Hello <t t-out=\"object.partner_id.name \"/>,\n"
"                </p>\n"
"                <t t-if=\"object.sale_order_line_ids.product_uom_qty &gt; "
"1\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;"
"\">\n"
"                        You have successfully acquired <strong><t t-"
"out=\"object.available_registrations\"/></strong>\n"
"                        registrations for the course <strong><t t-"
"out=\"object.channel_id.name or ''\">Course Name</t></strong>.\n"
"                    </p>\n"
"                    <p>\n"
"                        To allow participants to access the course, they "
"must complete their registration\n"
"                        using the following link. They can either log in "
"with their Odoo account or create a new participation.\n"
"                    </p>\n"
"                    <p>\n"
"                        <div style=\"margin: 32px 0px 32px 0px; text-align: "
"center;\">\n"
"                            <a t-att-href=\"object.invitation_link\" "
"style=\"background-color: #875A7B; padding: 8px 16px 8px 16px; text-"
"decoration: none; color: #fff; border-radius: 5px; font-size:13px;\">\n"
"                                <t t-out=\"object.invitation_link\"/>\n"
"                            </a>\n"
"                        </div>\n"
"                    </p>\n"
"                </t>\n"
"                <t t-else=\"\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;"
"\">\n"
"                        Your access to the course <strong><t t-out=\"object."
"channel_id.name or ''\">Course Name</t></strong> has been confirmed.\n"
"                    </p>\n"
"                    <p>\n"
"                        You can start learning by clicking the link below:\n"
"                    </p>\n"
"                    <p>\n"
"                        <div style=\"margin: 32px 0px 32px 0px; text-align: "
"center;\">\n"
"                            <a t-att-href=\"object.invitation_link\" "
"style=\"background-color: #875A7B; padding: 8px 16px 8px 16px; text-"
"decoration: none; color: #fff; border-radius: 5px; font-size:13px;\">\n"
"                                Click here to access the course\n"
"                            </a>\n"
"                        </div>\n"
"                    </p>\n"
"                </t>\n"
"                <p>Happy learning!</p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    Hola <t t-out=\"object.partner_id.name \"/>,\n"
"                </p>\n"
"                <t t-if=\"object.sale_order_line_ids.product_uom_qty &gt; "
"1\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;"
"\">\n"
"                        Has adquirido con éxito <strong><t t-"
"out=\"object.available_registrations\"/></strong>\n"
"                        inscripciones para el curso <strong><t t-"
"out=\"object.channel_id.name or ''\">Nombre del curso</t></strong>.\n"
"                    </p>\n"
"                    <p>\n"
"                        Para que los participantes accedan al curso, deben "
"completar su inscripción\n"
"                        utilizando el siguiente enlace. Pueden iniciar sesión "
"con su cuenta de Odoo o crear una nueva participación.\n"
"                    </p>\n"
"                    <p>\n"
"                        <div style=\"margin: 32px 0px 32px 0px; text-align: "
"center;\">\n"
"                            <a t-att-href=\"object.invitation_link\" "
"style=\"background-color: #875A7B; padding: 8px 16px 8px 16px; text-"
"decoration: none; color: #fff; border-radius: 5px; font-size:13px;\">\n"
"                                <t t-out=\"object.invitation_link\"/>\n"
"                            </a>\n"
"                        </div>\n"
"                    </p>\n"
"                </t>\n"
"                <t t-else=\"\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;"
"\">\n"
"                        Tu acceso al curso <strong><t t-out=\"object."
"channel_id.name or ''\">Nombre del curso</t></strong> ha sido confirmado.\n"
"                    </p>\n"
"                    <p>\n"
"                        Puedes comenzar a aprender haciendo clic en el siguiente enlace:\n"
"                    </p>\n"
"                    <p>\n"
"                        <div style=\"margin: 32px 0px 32px 0px; text-align: "
"center;\">\n"
"                            <a t-att-href=\"object.invitation_link\" "
"style=\"background-color: #875A7B; padding: 8px 16px 8px 16px; text-"
"decoration: none; color: #fff; border-radius: 5px; font-size:13px;\">\n"
"                                Haz clic aquí para acceder al curso\n"
"                            </a>\n"
"                        </div>\n"
"                    </p>\n"
"                </t>\n"
"                <p>¡Feliz aprendizaje!</p>\n"
"            </div>\n"
"        "

