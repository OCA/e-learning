#. module: website_sale_slides_multi_qty
#: model:mail.template,body_html:website_sale_slides_multi_qty.mail_template_slide_channel_confirm
msgid ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    Hello <t t-out=\"object.partner_id.name\"/>,\n"
"                </p>\n"
"                <t t-if=\"object.available_registrations &gt; 1\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        You have successfully acquired <strong>\n"
"                        <t t-out=\"object.available_registrations\"/>\n"
"                    </strong>\n"
"                        registrations for the course <strong>\n"
"                        <t t-out=\"object.channel_id.name or ''\">Course Name</t>\n"
"                    </strong>.\n"
"                    </p>\n"
"                    <p>\n"
"                        To allow participants to access the course, they must complete their registration\n"
"                        using the following link. They can either log in with their Odoo account or create a new participation.\n"
"                    </p>\n"
"                    <p>\n"
"                        </p><div style=\"margin: 32px 0px 32px 0px; text-align: center;\">\n"
"                            <a t-att-href=\"object.invitation_link\" style=\"background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;\">\n"
"                                Click here to access the course\n"
"                            </a>\n"
"                        </div>\n"
"                    \n"
"                </t>\n"
"                <t t-else=\"\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        Your access to the course <strong>\n"
"                        <t t-out=\"object.channel_id.name or ''\">Course Name</t>\n"
"                    </strong> has been confirmed.\n"
"                    </p>\n"
"                    <p>\n"
"                        You can start learning by clicking the link below:\n"
"                    </p>\n"
"                    <p>\n"
"                        </p><div style=\"margin: 32px 0px 32px 0px; text-align: center;\">\n"
"                            <a t-att-href=\"object.invitation_link\" style=\"background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;\">\n"
"                                Click here to access the course\n"
"                            </a>\n"
"                        </div>\n"
"                    \n"
"                </t>\n"
"                <p>Happy learning!</p>\n"
"            </div>\n"
"        "
msgstr ""
"<div style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                    Salve <t t-out=\"object.partner_id.name\"/>,\n"
"                </p>\n"
"                <t t-if=\"object.available_registrations &gt; 1\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">"
"\n"
"                        hai acquistato <strong>\n"
"                        <t t-out=\"object.available_registrations\"/>\n"
"                    </strong>\n"
"                        iscrizioni per il corso <strong>\n"
"                        <t t-out=\"object.channel_id.name or ''\">Nome del "
"corso</t>\n"
"                    </strong>.\n"
"                    </p>\n"
"                    <p>\n"
"                        Per consentire ai partecipanti di accedere al corso, "
"devono completare la loro registrazione\n"
"                        utilizzando il seguente collegamento. Possono anche "
"accedere con il proprio account Odoo o creare una nuova partecipazione.\n"
"                    </p>\n"
"                    <p>\n"
"                        </p><div style=\"margin: 32px 0px 32px 0px; text-"
"align: center;\">\n"
"                            <a t-att-href=\"object.invitation_link\" "
"style=\"background-color: #875A7B; padding: 8px 16px 8px 16px; text-"
"decoration: none; color: #fff; border-radius: 5px; font-size:13px;\">\n"
"                                Fare clic qui per accedere al corso\n"
"                            </a>\n"
"                        </div>\n"
"                    \n"
"                </t>\n"
"                <t t-else=\"\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">"
"\n"
"                        Il tuo accesso al corso <strong>\n"
"                        <t t-out=\"object.channel_id.name or ''\">Nome del "
"corso</t>\n"
"                    </strong> è stato confermato.\n"
"                    </p>\n"
"                    <p>\n"
"                        Puoi iniziare a imparare facendo clic sul "
"collegamento sottostante:\n"
"                    </p>\n"
"                    <p>\n"
"                        </p><div style=\"margin: 32px 0px 32px 0px; text-"
"align: center;\">\n"
"                            <a t-att-href=\"object.invitation_link\" "
"style=\"background-color: #875A7B; padding: 8px 16px 8px 16px; text-"
"decoration: none; color: #fff; border-radius: 5px; font-size:13px;\">\n"
"                                Fare clic qui per accedere al corso\n"
"                            </a>\n"
"                        </div>\n"
"                    \n"
"                </t>\n"
"                <p>Buon studio!</p>\n"
"            </div>\n"
"        "

#. module: website_sale_slides_multi_qty
#. odoo-python
#: code:addons/website_sale_slides_multi_qty/models/sale_order.py:0
msgid ""
"<p>Your registrations for the course <strong>%(course_name)s</strong> have "
"been increased by <strong>%(added_qty)s registration(s)</strong>.</p><p>You "
"now have a total of <strong>%(available_registrations)s</strong> "
"registration(s) purchased, of which <strong>%(used_registrations)s</strong> "
"have already been used and <strong>%(remaining_registrations)s</strong> are "
"still available.</p>"
msgstr ""
"<p>Le tue iscrizioni per il corso <strong>%(course_name)s</strong> sono "
"state incrementate di <strong>%(added_qty)s iscrizioni</strong>.</p><p>Ora "
"disponi di un totale di <strong>%(available_registrations)s</strong> "
"iscrizioni acquistate, di cui <strong>%(used_registrations)s</strong> già "
"utilizzate e <strong>%(remaining_registrations)s</strong> ancora "
"disponibili.</p>"

