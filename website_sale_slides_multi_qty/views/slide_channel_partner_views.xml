<odoo>
    <record id="slide_channel_partner_view_tree" model="ir.ui.view">
        <field name="model">slide.channel.partner</field>
        <field name="inherit_id" ref="website_slides.slide_channel_partner_view_tree" />
        <field name="arch" type="xml">
            <field name="partner_email" position="after">
                <field name="parent_id" invisible="0" />
                <field name="slide_channel_partner_name" />
                <field name="identification_number" />
                <field name="slide_channel_partner_email" />
                <field name="slide_channel_partner_phone" />
                <field name="used_registrations" string="Used" invisible="parent_id" />
                <field
                    name="remaining_registrations"
                    string="Remaining"
                    invisible="parent_id"
                />
                <field
                    name="available_registrations"
                    string="Total"
                    invisible="parent_id"
                />
            </field>
        </field>
    </record>
</odoo>
