<?xml version="1.0" ?>
<odoo>
    <template
        id="slide_fullscreen_sidebar_category"
        inherit_id="website_slides.slide_fullscreen_sidebar_category"
    >
        <xpath expr="//t[@t-set='can_access']" position="attributes">
            <attribute name="t-value">
                (can_access_channel or slide.is_preview) and not slide.is_blocked
            </attribute>
        </xpath>
    </template>
</odoo>
